{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "RELL"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "RELL listens only while you repeat a sentence aloud. What you say is recognised on this Mac and never recorded or sent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RELL yalnızca bir cümleyi sesli tekrar ederken dinler. Söylediğin bu Mac'te tanınır; kaydedilmez, hiçbir yere gönderilmez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RELL solo escucha mientras repites una frase en voz alta. Lo que dices se reconoce en este Mac; no se graba ni se envía."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RELL hört nur zu, während du einen Satz nachsprichst. Was du sagst, wird auf diesem Mac erkannt, nie aufgenommen oder gesendet."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "RELL turns what you say into text on this Mac to compare it with the sentence. Nothing is recorded or sent."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RELL, söylediğini cümleyle karşılaştırmak için bu Mac'te yazıya döker. Hiçbir şey kaydedilmez ya da gönderilmez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RELL convierte lo que dices en texto en este Mac para compararlo con la frase. No se graba ni se envía nada."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RELL wandelt das Gesagte auf diesem Mac in Text um, um es mit dem Satz zu vergleichen. Nichts wird aufgenommen oder gesendet."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
