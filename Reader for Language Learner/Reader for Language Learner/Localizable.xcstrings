    "Recaps and warm-ups use your AI provider, or Apple's on-device model where it's on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rückblicke und Aufwärmen nutzen deinen KI-Anbieter oder, wenn aktiviert, das Apple-Modell auf dem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
