    "Seconds. The last 200 requests are kept in memory and cleared when RELL quits. No words or sentences are kept." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saniye. Son 200 istek bellekte tutulur, RELL kapanınca silinir. Kelime ya da cümle tutulmaz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segundos. Las últimas 200 solicitudes se guardan en memoria y se borran al salir de RELL. No se guardan palabras ni frases."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekunden. Die letzten 200 Anfragen bleiben im Speicher und werden beim Beenden von RELL gelöscht. Wörter oder Sätze werden nicht behalten."
          }
        }
      }
    },
