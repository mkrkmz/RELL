    "Use New Note to capture a thought at your current position." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulunduğun konumdaki bir düşünceyi kaydetmek için Yeni Not'u kullan."
