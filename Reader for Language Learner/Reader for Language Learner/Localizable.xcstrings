    "New words are introduced first; By Stage picks recognising, typing or listening for each card." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni kelimeler önce tanıtılır; Aşamaya göre her kart için seçme, yazma ya da dinlemeyi seçer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las palabras nuevas se presentan primero; Por etapa elige reconocer, escribir o escuchar para cada tarjeta."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Wörter werden zuerst vorgestellt; „Nach Stufe“ wählt für jede Karte Erkennen, Tippen oder Hören."
          }
        }
      }
    },
    "New words: pick the right one. Learning: type the missing word. Settled: hear it and type it." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni kelimeler: doğrusunu seç. Öğrenilirken: eksik kelimeyi yaz. Oturmuş: dinle ve yaz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palabras nuevas: elige la correcta. Aprendiendo: escribe la palabra que falta. Asentadas: escúchala y escríbela."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Wörter: das richtige wählen. Im Lernen: das fehlende Wort tippen. Gefestigt: hören und tippen."
          }
        }
      }
    },
