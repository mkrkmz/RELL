    "Load: how long the first request took to load the model into memory. The test waits while you ask for something." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laden: wie lange die erste Anfrage brauchte, um das Modell in den Speicher zu laden. Der Test wartet, während du etwas fragst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carga: cuánto tardó la primera solicitud en cargar el modelo en memoria. La prueba espera mientras pides algo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleme: ilk isteğin modeli belleğe yüklemesi için geçen süre. Sen bir şey sorarken test bekler."
          }
        }
      }
    },
