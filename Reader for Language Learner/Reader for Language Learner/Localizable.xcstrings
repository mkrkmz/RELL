    "Nothing floats over the line you read. The hover balloon says where its answer came from, and the Aa panel shows a sample line." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts liegt über der Zeile, die du liest. Die Hover-Blase sagt, woher ihre Antwort kommt, und das Aa-Feld zeigt eine Beispielzeile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada flota sobre la línea que lees. El globo indica de dónde vino su respuesta, y el panel Aa muestra una línea de ejemplo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okuduğun satırın üstüne hiçbir şey binmiyor. İmleç balonu cevabın nereden geldiğini söylüyor, Aa paneli örnek bir satır gösteriyor."
          }
        }
      }
    },
