        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanımlar %1$@ dilinde kalır; anlamlar ve çeviriler %2$@ dilini kullanır. Bunu istediğin zaman Ayarlar'dan değiştirebilirsin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las definiciones quedan en %1$@; los significados y las traducciones usan %2$@. Puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Definitionen bleiben auf %1$@; Bedeutungen und Übersetzungen nutzen %2$@. Du kannst das jederzeit in den Einstellungen ändern."
          }
        }
      }
