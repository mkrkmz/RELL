    "Your words, notes, highlights, bookmarks and reading history will be replaced with the backup's. RELL will quit and open again." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelimelerin, notların, vurguların, yer imlerin ve okuma geçmişin yedektekilerle değiştirilecek. RELL kapanıp yeniden açılacak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus palabras, notas, resaltados, marcadores e historial de lectura se sustituirán por los de la copia. RELL se cerrará y volverá a abrirse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Wörter, Notizen, Markierungen, Lesezeichen und dein Leseverlauf werden durch die der Sicherung ersetzt. RELL wird beendet und neu geöffnet."
          }
        }
      }
    },
