    "Paste it when you describe a problem. It holds no words, sentences, book titles or keys, and nothing is sent by itself." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sorunu anlatırken bunu yapıştırabilirsin. Kelime, cümle, kitap adı ya da anahtar içermez; hiçbir şey kendiliğinden gönderilmez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pégalo cuando describas un problema. No contiene palabras, frases, títulos de libros ni claves, y no se envía nada por sí solo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge ihn ein, wenn du ein Problem beschreibst. Er enthält keine Wörter, Sätze, Buchtitel oder Schlüssel, und nichts wird von selbst gesendet."
