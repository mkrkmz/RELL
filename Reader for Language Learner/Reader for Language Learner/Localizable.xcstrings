    "A book shows its own words" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitap kendi kelimelerini gösteriyor"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
