            "value" : "Wohin dein Text geht"
          }
        }
      }
    },
    "Which modules and actions sit on the word and sentence cards; the rest wait in •••." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelime ve cümle kartında hangi modüllerin ve işlemlerin duracağı; gerisi ••• içinde bekler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué módulos y acciones están en las tarjetas de palabra y de frase; el resto espera en •••."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welche Module und Aktionen auf den Wort- und Satzkarten liegen; der Rest wartet im •••."
          }
        }
      }
    },
    "WHICH WORD FITS?" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HANGİ KELİME UYUYOR?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿QUÉ PALABRA ENCAJA?"
          }
        },
        "de" : {
