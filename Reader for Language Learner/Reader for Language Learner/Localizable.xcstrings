          "stringUnit" : {
            "state" : "translated",
            "value" : "RELL günde en fazla bir kez GitHub'a son sürüm numarasını sorar. Kendi kendine hiçbir şey indirmez ya da kurmaz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como mucho una vez al día, RELL pregunta a GitHub por el número de la última versión. Nunca descarga ni instala nada por sí mismo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchstens einmal am Tag fragt RELL GitHub nach der neuesten Versionsnummer. Es lädt und installiert nie selbst etwas."
