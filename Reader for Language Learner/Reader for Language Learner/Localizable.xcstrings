            "state" : "translated",
            "value" : "WELCHES WORT PASST?"
          }
        }
      }
    },
    "While reading, double-click a word and choose Save. It shows up here, ready to review." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okurken bir kelimeye çift tıkla ve Kaydet'i seç. Burada tekrara hazır görünür."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mientras lees, haz doble clic en una palabra y elige Guardar. Aparece aquí, lista para repasar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppelklicke beim Lesen auf ein Wort und wähle Speichern. Es erscheint hier, bereit zur Wiederholung."
          }
        }
      }
    },
    "Why" : {
      "localizations" : {
