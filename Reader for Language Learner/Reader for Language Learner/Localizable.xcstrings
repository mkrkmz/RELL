    "Choose a provider for what Apple's model doesn't do — pronunciation, etymology, mnemonics, collocations and word family. A local server is private and free." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Anbieter für das, was das Apple-Modell nicht macht – Aussprache, Etymologie, Eselsbrücken, Kollokationen und Wortfamilie. Ein lokaler Server ist privat und kostenlos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un proveedor para lo que no hace el modelo de Apple: pronunciación, etimología, trucos de memoria, colocaciones y familia de palabras. Un servidor local es privado y gratuito."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple modelinin yapmadığı işler için bir sağlayıcı seç: telaffuz, köken, akılda tutma ipucu, eş dizimler ve kelime ailesi. Yerel bir sunucu gizli ve ücretsizdir."
          }
        }
      }
    },
