    "This Mac (on-device speech recognition)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac (cihaz içi konuşma tanıma)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac (reconocimiento de voz en el dispositivo)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac (Spracherkennung auf dem Gerät)"
          }
        }
      }
    },
    "This Mac can run Apple's on-device model. With it, definitions, meanings, examples and synonyms come in about a second — no setup, no internet, no cost." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac, Apple'ın cihaz içi modelini çalıştırabiliyor. Açarsan tanımlar, anlamlar, örnekler ve eş anlamlılar yaklaşık bir saniyede gelir; kurulum, internet ya da ücret gerekmez."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac puede usar el modelo de Apple en el dispositivo. Con él, las definiciones, significados, ejemplos y sinónimos llegan en un segundo aprox.: sin configuración, sin internet, sin coste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac kann das Apple-Modell auf dem Gerät nutzen. Damit kommen Definitionen, Bedeutungen, Beispiele und Synonyme in etwa einer Sekunde – ohne Einrichtung, ohne Internet, ohne Kosten."
          }
        }
      }
    },
    "This Mac doesn't support Apple Intelligence." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac Apple Intelligence'ı desteklemiyor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no es compatible con Apple Intelligence."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac unterstützt Apple Intelligence nicht."
          }
        }
      }
    },
    "This Mac has %lld GB of memory: a %@ model (Q4) runs fast here. Bigger ones answer slowly; cloud models (…-cloud) don't use this Mac at all." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "This Mac has %1$lld GB of memory: a %2$@ model (Q4) runs fast here. Bigger ones answer slowly; cloud models (…-cloud) don't use this Mac at all."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac'te %1$lld GB bellek var: %2$@ boyutlu (Q4) bir model burada hızlı çalışır. Daha büyükleri yavaş yanıt verir; bulut modelleri (…-cloud) bu Mac'i hiç kullanmaz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac tiene %1$lld GB de memoria: un modelo de %2$@ (Q4) funciona rápido aquí. Los más grandes responden despacio; los modelos en la nube (…-cloud) no usan este Mac en absoluto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac hat %1$lld GB Speicher: Ein %2$@-Modell (Q4) läuft hier schnell. Größere antworten langsam; Cloud-Modelle (…-cloud) nutzen diesen Mac gar nicht."
          }
        }
      }
    },
    "This model is slow on this Mac. A smaller one answers faster." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu model bu Mac'te yavaş. Daha küçük bir model daha hızlı yanıt verir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modelo va lento en este Mac. Uno más pequeño responde más rápido."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Modell ist auf diesem Mac langsam. Ein kleineres antwortet schneller."
          }
        }
      }
    },
