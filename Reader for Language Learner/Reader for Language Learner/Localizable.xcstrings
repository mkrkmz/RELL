        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Speichern eines Wortes"
          }
        }
      }
    },
    "Where you met the word, under it. Turn off to test the word alone." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelimenin altında, onu nerede gördüğün. Kelimeyi tek başına sınamak için kapat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dónde encontraste la palabra, debajo de ella. Desactívalo para ponerte a prueba solo con la palabra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wo du das Wort getroffen hast, darunter. Ausschalten, um nur das Wort abzufragen."
          }
        }
