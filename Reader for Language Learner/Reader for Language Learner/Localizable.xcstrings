        }
      }
    },
    "A short story at your level that uses the words you're due to review. It opens as a book; reading it doesn't change when they come up again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze Geschichte auf deinem Niveau mit den Wörtern, die zur Wiederholung anstehen. Sie öffnet sich als Buch; das Lesen ändert nicht, wann sie wiederkommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un cuento corto a tu nivel con las palabras que te toca repasar. Se abre como un libro; leerlo no cambia cuándo vuelven a salir."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekrar zamanı gelen kelimelerini kullanan, seviyene uygun kısa bir hikâye. Kitap olarak açılır; okuman kelimelerin ne zaman yeniden soracağını değiştirmez."
          }
        }
      }
    },
    "A short story with the words due" : {
