    },
    "Your session's trail, your streak and a run of remembered answers — and a summary worth a look." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturumunun izi, serin ve üst üste hatırladıkların; sonunda da bakmaya değer bir özet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El rastro de tu sesión, tu racha y una serie de respuestas recordadas, con un resumen que merece la pena mirar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Spur deiner Sitzung, deine Serie und eine Reihe gewusster Antworten – und eine Zusammenfassung, die sich lohnt."
          }
        }
      }
    },
