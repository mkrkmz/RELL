    "Higher values produce more creative/varied output. Lower values are more focused and deterministic. Changes take effect on the next request." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Werte liefern kreativere, abwechslungsreichere Antworten, niedrigere fokussiertere und vorhersehbarere. Änderungen gelten ab der nächsten Anfrage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los valores altos dan respuestas más creativas y variadas; los bajos, más centradas y previsibles. Los cambios se aplican en la siguiente solicitud."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüksek değerler daha yaratıcı ve çeşitli çıktı üretir. Düşük değerler daha odaklı ve öngörülebilirdir. Değişiklikler bir sonraki istekte geçerli olur."
          }
        }
      }
    },
