    },
    "Use this word in a sentence of your own; the AI corrects it" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu kelimeyi kendi cümlende kullan; yapay zekâ düzeltir"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa esta palabra en una frase propia; la IA la corrige"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende dieses Wort in einem eigenen Satz; die KI korrigiert ihn"
          }
        }
      }
    },
    "Used by pronounce buttons and Read Page Aloud (Speech menu)." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telaffuz düğmeleri ve Sayfayı Sesli Oku (Konuşma menüsü) tarafından kullanılır."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo usan los botones de pronunciación y Leer la página en voz alta (menú Voz)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird von den Aussprache-Tasten und „Seite vorlesen“ (Menü Sprache) verwendet."
          }
        }
      }
    },
    "Used for definitions, meanings, examples, synonyms, usage notes, Ask AI and word levels. Pronunciation, etymology, mnemonics, collocations and word family always use the provider below — the on-device model gets them wrong too often." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanımlar, anlamlar, örnekler, eş anlamlılar, kullanım notları, takip soruları ve kelime seviyeleri için kullanılır. Telaffuz, etimoloji, hatırlatıcılar, eşdizimler ve kelime ailesi her zaman aşağıdaki sağlayıcıyı kullanır — cihaz içi model bunlarda çok sık yanılıyor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para definiciones, significados, ejemplos, sinónimos, notas de uso, preguntas a la IA y niveles de palabras. Pronunciación, etimología, trucos de memoria, colocaciones y familia de palabras usan siempre el proveedor de abajo: el modelo en el dispositivo se equivoca demasiado en ellos."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für Definitionen, Bedeutungen, Beispiele, Synonyme, Gebrauchshinweise, KI-Fragen und Wortniveaus verwendet. Aussprache, Etymologie, Eselsbrücken, Kollokationen und Wortfamilie nutzen immer den Anbieter unten – das Modell auf dem Gerät liegt dabei zu oft falsch."
          }
        }
      }
    },
