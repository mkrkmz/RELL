    },
    "The modules moved onto the word card. Edit Card… chooses which stay there and which wait in •••." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Module sind auf die Wortkarte umgezogen. „Karte bearbeiten …“ legt fest, welche dort bleiben und welche im ••• warten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
