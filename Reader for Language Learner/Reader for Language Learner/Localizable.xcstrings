    "This text is prepended to the built-in system prompt for every module. Leave empty to use the default. Use this to add domain-specific instructions (e.g. \"Always provide IPA pronunciation\")." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu metin her modülün yerleşik sistem prompt'unun başına eklenir. Varsayılanı kullanmak için boş bırak. Alana özgü talimatlar eklemek için kullan (örn. \"Her zaman IPA telaffuzu ver\")."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este texto se antepone a las instrucciones del sistema de cada módulo. Déjalo vacío para usar el predeterminado. Úsalo para añadir indicaciones de un ámbito (p. ej., «Da siempre la pronunciación en AFI»)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Text wird dem eingebauten Systemprompt jedes Moduls vorangestellt. Leer lassen für den Standard. Nutze ihn für fachspezifische Anweisungen (z. B. „Gib immer die IPA-Aussprache an“)."
          }
        }
      }
    },
