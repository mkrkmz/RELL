    "When you finish a book chapter, offer three short questions on it. The chapter panel always has the check." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kitap bölümünü bitirince onunla ilgili üç kısa soru öner. Kontrol, bölüm panelinde her zaman var."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al terminar un capítulo de un libro, ofrece tres preguntas cortas sobre él. El panel del capítulo siempre tiene la comprobación."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einem Buchkapitel drei kurze Fragen dazu anbieten. Im Kapitel-Feld gibt es den Check immer."
          }
        }
      }
    },
    "When You Save a Word" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelime kaydedince"
          }
        },
        "es" : {
